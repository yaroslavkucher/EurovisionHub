@model IEnumerable<EurovisionHub.Models.EventType>

@{
    ViewData["Title"] = "EventTypes";
}

<h1>EventTypes</h1>

<p>
    <a asp-action="Create" class="btn-glass-add">+ Add New</a>
</p>

<div class="table-responsive">
<table class="table glass-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/edit.png" alt="Edit" style="width:20px; height:20px;" />
                    </a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/info.png" alt="Details" style="width:23px; height:23px;" />
                    </a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/delete.png" alt="Delete" style="width:20px; height:20px;" />
                    </a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>