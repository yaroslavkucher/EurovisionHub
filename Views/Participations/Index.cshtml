@model IEnumerable<EurovisionHub.Models.Participation>

@{
    ViewData["Title"] = "Participations";
}

<div class="page-first-row">
    <div>
<h1>Participations</h1>
@if (User.IsAdmin())
{
    <a asp-action="Create" class="btn-glass-add">+ Add New</a>
}
</div>
</div>

<div class="table-responsive">
<table class="table glass-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Event)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Song)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderNumber)
            </th>
                <th>
                    @Html.DisplayNameFor(model => model.Place)
                </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Event.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Country.Name)
            </td>
            <td>
                <span>@Html.DisplayFor(modelItem => item.Song.Artist) - @Html.DisplayFor(modelItem => item.Song.Title)</span>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderNumber)
            </td>
            <td>
                        @Html.DisplayFor(modelItem => item.Place)
            </td>
            
            <td>
                <div class="edit-menu">
                @if (User.IsAdmin())
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/edit.png" alt="Edit" style="width:20px; height:20px;" />
                    </a>
                    <span>|</span>
                }
                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/info.png" alt="Details" style="width:23px; height:23px;" />
                    </a>
                @if (User.IsAdmin())
                {
                        <span>|</span>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-decoration-none">
                            <img src="~/img/delete.png" alt="Delete" style="width:20px; height:20px;" />
                        </a>
                }
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
