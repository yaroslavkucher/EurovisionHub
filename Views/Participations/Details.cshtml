@model EurovisionHub.Models.Participation

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Participation</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Country)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Country.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Song)
        </dt>
        <dd class="col-sm-10">
            <p>@Html.DisplayFor(model => model.Song.Artist) - @Html.DisplayFor(model => model.Song.Title)</p>
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrderNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrderNumber)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsAdmin())
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-glass-edit">Edit</a>
    }
    <a asp-action="Index" class="btn-glass-submit">Back to List</a>
</div>
<hr />
<div class="row">
    <div class="col-md-8 offset-md-2">
        <h4 class="text-center">Jury vs Televotes</h4>
        <div style="height: 300px;">
            <canvas id="pointsChart"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    const juryPoints = @ViewBag.JuryPoints;
    const televotePoints = @ViewBag.TelevotePoints;

    const ctx = document.getElementById('pointsChart').getContext('2d');
    new Chart(ctx, {
    type: 'bar',
    data: {
    labels: ['Jury', 'Televotes'],
    datasets: [{
    label: 'Points',
    data: [juryPoints, televotePoints],
    backgroundColor: ['#00d1ff', '#ff0050'],
    borderRadius: 10
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
    legend: {
    display: false
    }
    },
    scales: {
    y: {
    beginAtZero: true,
    ticks: { color: 'white' },
    grid: { color: 'rgba(255, 255, 255, 0.1)' }
    },
    x: {
    ticks: { color: 'white' },
    grid: { display: false }
    }
    }
    }
    });
    });
</script>