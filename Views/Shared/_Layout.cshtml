<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (@ViewData["Title"] != "EurovisionHub")
    {
        <title>@ViewData["Title"] - EurovisionHub</title>
    }
    else
    {
        <title>@ViewData["Title"]</title>
    }
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EurovisionHub.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/star_icon_176577.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
</head>
<body>
    <header>
        <div class="glass-navbar">
            <div class="" style="display: flex; align-items: center; gap: 5px;">
                <!--<img src="~/img/Gemini_Generated_Image_i5amjui5amjui5am-Photoroom (1).png"
                     style="width:40px; height:70px; border-radius: 10px;" />-->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EurovisionHub</a>
            </div>
            <nav class="my-nav">
                <ul class="modern-navbar">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Countries" asp-action="Index">Countries</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Events" asp-action="Index">Events</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Participations" asp-action="Index">Participations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Songs" asp-action="Index">Songs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Votes" asp-action="Index">Votes</a>
                    </li>
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-center" style="display: flex; flex-direction: column;" asp-controller="AdminPanel" asp-action="Requests">
                                <span>Admin</span>
                                <span>Panel</span>
                            </a>
                        </li>
                    }
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (!User.IsInRole("SuperAdmin"))
                                {
                            <li class="nav-item">
                                <a class="nav-link text-center" style="display: flex; flex-direction: column;"
                                   asp-controller="Account" asp-action="ApplyForAdmin">
                                   <span>Become</span>
                                   @if(User.IsInRole("User"))
                                            {
                                                <span>Admin</span>
                                            }
                                            else
                                            {
                                                <span>SuperAdmin</span>
                                            }
                                        </a>
                            </li>
                        }
                        <li class="nav-item">
                             <span class="nav-link" style="width: 100px">Hello, @User.Identity.Name!</span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                                <button type="submit" class="nav-link">Sign Out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <!--<li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">Sign Up</a>
                        </li>-->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (User.Identity.IsAuthenticated)
    {
        @using Microsoft.AspNetCore.Identity
        @inject UserManager<ApplicationUser> UserManager
            var user = await UserManager.GetUserAsync(User);
            if (user != null && user.ShowRoleChangeNotification)
            {
                <div class="alert alert-info alert-dismissible fade show mt-4" role="alert">
                    <i class="bi bi-info-circle-fill"></i>
                    <strong>Role is changed!</strong> 
                    Now you are: <span class="badge bg-dark">@( (await UserManager.GetRolesAsync(user)).FirstOrDefault() )</span>.
                    <hr>
                    <p class="mb-0">Administrator's comment: <em>@user.RoleChangeComment</em></p>
                </div>
                
                user.ShowRoleChangeNotification = false;
                await UserManager.UpdateAsync(user);
            }
    }
            @RenderBody()
        </main>
    </div>

    <footer class="footer glass-footer">
        <div class="container text-center">
            &copy; 2026 - EurovisionHub - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <partial name="_Notifications" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
