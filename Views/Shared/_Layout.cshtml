<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (@ViewData["Title"] != "EurovisionHub")
    {
        <title>@ViewData["Title"] - EurovisionHub</title>
    }
    else
    {
        <title>@ViewData["Title"]</title>
    }
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EurovisionHub.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/x-icon" href="~/star_icon_176577.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
</head>
<body>
    <header>
        <div class="glass-navbar">
            <div class="" style="display: flex; align-items: center; gap: 5px;">
                <!--<img src="~/img/Gemini_Generated_Image_i5amjui5amjui5am-Photoroom (1).png"
                     style="width:40px; height:70px; border-radius: 10px;" />-->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EurovisionHub</a>
            </div>
            <nav class="my-nav">
                <ul class="modern-navbar">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Countries" asp-action="Index">Countries</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Events" asp-action="Index">Events</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Participations" asp-action="Index">Participations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Songs" asp-action="Index">Songs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Votes" asp-action="Index">Votes</a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        @inject SignInManager<ApplicationUser> SignInManager

                        @inject UserManager<ApplicationUser> UserManager

                        <ul class="navbar-nav">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                var shortName = User.Identity?.Name?.Split('@')[0] ?? "User";
        
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
                                        <img src="https://ui-avatars.com/api/?name=@shortName&background=random&size=32"
                                             alt="Avatar"
                                             class="rounded-circle border border-2 border-white shadow-sm"
                                             style="width: 32px; height: 32px; object-fit: cover;">
                
                                        <span class="fw-medium text-white">@shortName</span>
                                    </a>
            
                                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 glass-dropdown" aria-labelledby="userDropdown">
                                        <li>
                                            <div class="px-3 py-2">
                                                <p class="mb-0 small text-muted">Signed in as</p>
                                                <p class="mb-0 fw-bold text-truncate" style="max-width: 180px;">@User.Identity?.Name</p>
                                            </div>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="Profile">
                                                <i class="bi bi-person-circle me-2 text-primary"></i> My Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="ChangePassword">
                                                <i class="bi bi-shield-lock me-2 text-primary"></i> Change Password
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider"></li>
                                        @if (!User.IsInRole("SuperAdmin"))
                                        {
                                            <li>
                                                <a class="dropdown-item d-flex align-items-center admin-link" asp-controller="Account" asp-action="ApplyForAdmin" style="gap: 2px;">
                                                    <i class="bi bi-gear-fill me-2"></i> <span>Become</span>
                                                    @if (User.IsInRole("User"))
                                                    {
                                                        <span>Admin</span>
                                                    }
                                                    else
                                                    {
                                                        <span>SuperAdmin</span>
                                                    }
                                                </a>
                                            </li>
                                        } 
                                        else
                                        {
                                            <li>
                                                <a class="dropdown-item d-flex align-items-center admin-link" asp-controller="AdminPanel" asp-action="Users">
                                                    <i class="bi bi-gear-fill me-2"></i> Administration
                                                </a>
                                            </li>
                                        }

                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                                <button type="submit" class="dropdown-item d-flex align-items-center text-danger">
                                                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link btn btn-outline-primary rounded-pill px-3 me-2" asp-controller="Account" asp-action="Login">Login</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link btn btn-primary rounded-pill px-3 text-white" asp-controller="Account" asp-action="Register">Register</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-right me-2"></i>Sign In
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (User.Identity.IsAuthenticated)
    {
        @using Microsoft.AspNetCore.Identity
        @inject UserManager<ApplicationUser> UserManager
            var user = await UserManager.GetUserAsync(User);
            if (user != null && user.ShowRoleChangeNotification)
            {
                <div class="alert alert-info alert-dismissible fade show mt-4" role="alert">
                    <i class="bi bi-info-circle-fill"></i>
                    <strong>Role is changed!</strong> 
                    Now you are: <span class="badge bg-dark">@( (await UserManager.GetRolesAsync(user)).FirstOrDefault() )</span>.
                    <hr>
                    <p class="mb-0">Administrator's comment: <em>@user.RoleChangeComment</em></p>
                </div>
                
                user.ShowRoleChangeNotification = false;
                await UserManager.UpdateAsync(user);
            }
    }
            @RenderBody()
        </main>
    </div>

    <footer class="footer glass-footer">
        <div class="container text-center">
            &copy; 2026 - EurovisionHub - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <partial name="_Notifications" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
