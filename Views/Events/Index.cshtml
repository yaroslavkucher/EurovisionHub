@model IEnumerable<EurovisionHub.Models.Event>

@{
    ViewData["Title"] = "Events";
}
<div class="page-first-row">
    <div class="page-info">
    <h1>Events</h1>
    <a asp-action="Create" class="btn-glass-add">+ Add New</a>
    </div>
    <a asp-area="" asp-controller="EventTypes" asp-action="Index">Edit event types</a>
</div>

<div class="table-responsive">
<table class="table glass-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HostCountry)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    <img src="@(item.HostCountry.FlagUrl ?? "https://placehold.jp/50x30.png?text=No+Flag")"
                         alt="@item.Name Flag"
                         style="width:50px; height:30px; border-radius:4px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);" />
                    @Html.DisplayFor(modelItem => item.HostCountry.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Type.Name)
            </td>
            <td>
                @item.Date.Value.ToString("dd.MM.yyyy HH:mm")
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/edit.png" alt="Edit" style="width:20px; height:20px;" />
                    </a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/info.png" alt="Details" style="width:23px; height:23px;" />
                    </a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/delete.png" alt="Delete" style="width:20px; height:20px;" />
                    </a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
