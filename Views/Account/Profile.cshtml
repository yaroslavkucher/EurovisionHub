@model EurovisionHub.Models.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "My profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body text-center p-5">
                    
                    <div class="mb-4">
                        <img src="https://ui-avatars.com/api/?name=@Model.Username&background=random&size=150"
                             alt="Avatar"
                             class="rounded-circle shadow-sm"
                             style="width: 150px; height: 150px; object-fit: cover;">
                    </div>

                    <h3 class="fw-bold mb-1">@Model.Username</h3>
                    <p class="text-muted mb-3">@Model.Email</p>
                    <p class="small text-secondary mb-3">
                        <i class="bi bi-calendar3"></i> Registration date: @Model.RegistrationDate.ToString("dd.MM.yyyy")
                    </p>
                    
                    @if (Model.Roles != null && Model.Roles.Any(r => r == "Admin" || r == "SuperAdmin"))
                    {
                        <div class="mb-4">
                            <span class="text-muted small me-2">Current role:</span>
                            @foreach (var role in Model.Roles)
                            {
                                if (role == "Admin" || role == "SuperAdmin")
                                {
                                    var badgeClass = role == "SuperAdmin" ? "bg-danger" : "bg-primary";
                                    <span class="badge @badgeClass fs-6 align-middle me-1">@role</span>
                                }
                            }
                        </div>
                    }

                    @if (Model.ShowRoleChangeNotification)
                    {
                        <div class="alert alert-info text-start rounded-3 mb-4" role="alert">
                            <div class="d-flex align-items-center mb-1">
                                <i class="bi bi-info-circle-fill me-2"></i>
                                <strong class="small">System Notification</strong>
                            </div>
                            <p class="mb-0">Your account privileges have been updated.</p>
                            @if (!string.IsNullOrEmpty(Model.RoleChangeComment))
                            {
                                <hr class="my-2">
                                <p class="mb-0 small"><em>Admin comment:</em> @Model.RoleChangeComment</p>
                            }
                        </div>
                    }

                    @if (Model.LatestRoleRequest != null && Model.LatestRoleRequest.Status == EurovisionHub.Models.RequestStatus.Pending)
                    {
                        <div class="alert alert-warning text-start rounded-3 mb-4" role="alert">
                            <h6 class="alert-heading fw-bold mb-1">Role request: "@Model.LatestRoleRequest.RequestedRole"</h6>
                            <p class="mb-0 small">Status: <strong>Pending Review</strong></p>
                            <p class="mb-0 x-small text-muted mt-1">Our team is currently evaluating your application.</p>
                        </div>
                    }
                    else if (Model.LatestRoleRequest != null && Model.LatestRoleRequest.Status == EurovisionHub.Models.RequestStatus.Rejected)
                    {
                        <div class="alert alert-danger text-start rounded-3 mb-4" role="alert">
                            <h6 class="alert-heading fw-bold mb-1">Request Rejected</h6>
                            <p class="mb-0 small">The request for "@Model.LatestRoleRequest.RequestedRole" status was not approved.</p>
                            @if (!string.IsNullOrEmpty(Model.LatestRoleRequest.AdminComment))
                            {
                                <hr class="my-2">
                                <p class="mb-0 small"><em>Reason:</em> @Model.LatestRoleRequest.AdminComment</p>
                            }
                        </div>
                    }

                    <hr class="my-4 text-muted">

                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-primary px-4 rounded-pill">
                            Change password
                        </a>
                        
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-danger px-4 rounded-pill">
                                Logout
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>