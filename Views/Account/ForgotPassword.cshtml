@model EurovisionHub.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    .form-container .form-control { background-color: #ffffff !important; color: #212529 !important; border: 1px solid #ced4da !important; }
    .form-container .form-control:focus { border-color: #86b7fe !important; box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important; }
    .form-container label { color: #212529 !important; font-weight: 600; }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3" style="background-color: #ffffff;">
                <div class="card-body p-5 form-container">
                    <div class="text-center mb-4">
                        <i class="bi bi-envelope-at text-primary" style="font-size: 3rem;"></i>
                        <h3 class="fw-bold mt-2">Reset Password</h3>
                        <p class="text-muted small">Enter your email and we'll send you a reset link.</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                        <div class="mb-3 text-start">
                            <label asp-for="Email" class="form-label ps-2">Email Address</label>
                            <input asp-for="Email" class="form-control rounded-3 py-2" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        @if (ViewBag.SuggestRegistration == true)
                        {
                            <div class="text-center mb-4 mt-2">
                                <span class="text-muted small">Don't have an account?</span> 
                                <a asp-action="Register" class="text-decoration-none fw-semibold small text-primary">Sign Up</a>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4"></div>
                        }

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill py-2 fw-bold">Send Reset Link</button>
                            <a asp-action="Login" class="btn btn-outline-secondary rounded-pill py-2">Back to Login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}