@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h1 class="text-danger display-4">403</h1>
            <h2 class="mb-4">Access Denied</h2>
            <p class="lead">Sorry, but you do not have sufficient permissions to view this page.</p>
            <p>If you believe this is an error, please contact the administrator.</p>
            
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Return to home page</a>
        </div>
    </div>
</div>