@{
    ViewData["Title"] = "Apply for Admin";
    string head = "Apply", description = "Discribe your motivation:", placeholder = "Your motivation...";

    @if (User.IsInRole("User"))
    {
        head = "Apply for the role of Administrator";
        description = "Describe why you want to join the EurovisionHub moderation team:";
        placeholder = "For example: I want to add new songs and results from previous years...";
    }
    else if (User.IsInRole("Admin"))
    {
        head = "Apply for the role of SuperAdmin";
        description = "Describe why you want to expand your permissions:";
        placeholder = "For example: I have been working for 5 years. I have a strong desire to develop...";
    }
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="glass-card">
                <div class="glass-card-header">
                    <h4>@head</h4>
                </div>
                <div class="glass-card-body">
                    <p>@description</p>
                    
                    <form asp-action="ApplyForAdmin" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="mb-3">
                            <label for="motivation" class="form-label">Your motivation</label>
                            <textarea id="motivation" name="motivation" class="form-control glass-input" rows="5" required
                                      placeholder="@placeholder"></textarea>
                            <span class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Submit</button>
                            <a asp-action="Index" asp-controller="Home" class="btn-glass-submit">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>