@model EurovisionHub.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Set New Password";
}

<style>
    .form-container .form-control { background-color: #ffffff !important; color: #212529 !important; border: 1px solid #ced4da !important; }
    .form-container .form-control:focus { border-color: #86b7fe !important; box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important; }
    .form-container label { color: #212529 !important; font-weight: 600; }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3" style="background-color: #ffffff;">
                <div class="card-body p-5 form-container">
                    <div class="text-center mb-4">
                        <i class="bi bi-key text-primary" style="font-size: 3rem;"></i>
                        <h3 class="fw-bold mt-2">New Password</h3>
                        <p class="text-muted small">Setting a new password for:<br><strong>@Model.Email</strong></p>
                    </div>

                    <form asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>
                        
                        <input asp-for="Code" type="hidden" />
                        <input asp-for="Email" type="hidden" />

                        <div class="mb-3 text-start">
                            <label asp-for="Password" class="form-label ps-2">New Password</label>
                            <input asp-for="Password" class="form-control rounded-3 py-2" placeholder="Minimum 6 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 text-start">
                            <label asp-for="ConfirmPassword" class="form-label ps-2">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control rounded-3 py-2" placeholder="Repeat password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary rounded-pill py-2 fw-bold">Update Password</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}