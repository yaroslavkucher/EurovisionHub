@{
    ViewData["Title"] = "Invalid Link";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3 text-center p-5" style="background-color: #ffffff;">
                <div class="mb-4">
                    <i class="bi bi-x-circle text-danger" style="font-size: 4rem;"></i>
                </div>
                
                <h3 class="fw-bold text-dark mb-3">Link Expired or Invalid</h3>
                
                <p class="text-muted small mb-4">
                    This password reset link has expired, has already been used, or is invalid. For security reasons, please request a new one.
                </p>
                
                <div class="d-grid">
                    <a asp-action="ForgotPassword" class="btn btn-primary rounded-pill py-2 fw-bold">
                        Request New Link
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>