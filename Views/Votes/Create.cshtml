@model EurovisionHub.Models.Vote

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Vote</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="FromCountry" class="control-label"></label>
                <select asp-for="FromCountryId" class ="form-control" asp-items="ViewBag.FromCountry"></select>
                <span asp-validation-for="FromCountryId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ToParticipation" class="control-label">ToCountry</label>
                <select asp-for="ToParticipationId" class ="form-control" asp-items="ViewBag.ToCountry"></select>
                <span asp-validation-for="ToParticipationId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Points" class="control-label"></label>
                <input asp-for="Points" class="form-control" />
                <span asp-validation-for="Points" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsJury" /> @Html.DisplayNameFor(model => model.IsJury)
                </label>
            </div>
            <input type="hidden" name="EventId" value="@ViewBag.SelectedEventId" />
            <div class="mb-3">
                <input type="submit" value="Create" class="btn-glass-submit" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" asp-route-eventId="@ViewBag.SelectedEventId">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
