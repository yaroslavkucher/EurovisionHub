@model EurovisionHub.Models.VotingViewModel

@{
    ViewData["Title"] = "Votes";
}

@if (Model.SelectedEventId.HasValue)
{
    <h1>@Model.SelectedEventName</h1>
}
else
{
    <h1>Votes</h1>
}

<div class="d-flex justify-content-between mb-4">
    <div class="align-content-center">
        <a asp-action="Create" asp-route-selectedEventId="@Model.SelectedEventId" class="btn-glass-add">+ Add New</a>
    </div>

    <div class="d-flex flex-column gap-2">
        <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle w-100" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                Export Data
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="exportDropdown">
                @if (Model.SelectedEventId.HasValue)
                {
                    <li><a class="dropdown-item" asp-action="Export" asp-route-eventId="@Model.SelectedEventId">Export Current Event</a></li>
                }
                <li><a class="dropdown-item" asp-action="Export">Export All Events</a></li>
            </ul>
        </div>

        <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#importModal">
            Import Data
        </button>
    </div>
</div>

<div class="table-responsive">
<table class="table glass-table">
    <thead>
        <tr>
            <th>FromCountry</th>
            <th>ToCountry</th>
            <th>Jury/Televote</th>
            <th>Points</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Votes)
        {
            <tr>
                <td>@item.FromCountry?.Name</td>
                <td>@item.ToParticipation?.Country.Name</td>
                <td>
                    @(item.IsJury ? "Jury" : "Televote")
                </td>
                <td>@item.Points</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/edit.png" alt="Edit" style="width:20px; height:20px;" />
                    </a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/info.png" alt="Details" style="width:23px; height:23px;" />
                    </a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-decoration-none">
                        <img src="~/img/delete.png" alt="Delete" style="width:20px; height:20px;" />
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<div class="modal fade" id="eventSelectionModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Select an event</h5>
            </div>
            <div class="modal-body">
                <form id="eventForm" method="get" asp-action="Index">
                    <div class="mb-3">
                        <label for="eventId">Events:</label>
                        <select name="eventId" id="eventId" class="form-control" required oninvalid="this.setCustomValidity('Please, select event from the list!')"
                                oninput="this.setCustomValidity('')">
                            <option value="">-- Select an event --</option>
                            @foreach (var ev in Model.Events.OrderByDescending(e => e.Date))
                            {
                                <option value="@ev.Id">@ev.Name - @ev.Date.Value.Year</option>
                            }
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importModalLabel">Import Votes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Import" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <p>1. Download the template and fill it with your data.</p>
                        <a asp-action="DownloadTemplate" asp-route-eventId="@Model.SelectedEventId" class="btn btn-outline-info btn-sm">Download Template</a>
                    </div>
                    <hr />
                    <div class="mb-3">
                        <p>2. Upload the completed Excel file.</p>
                        <label for="importFile" class="form-label">Select .xlsx file</label>
                        <input class="form-control" type="file" id="importFile" name="importFile" accept=".xlsx" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Upload & Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const urlParams = new URLSearchParams(window.location.search);
            if (!urlParams.has('eventId')) {
                var myModal = new bootstrap.Modal(document.getElementById('eventSelectionModal'));
                myModal.show();
            }
        });
    </script>
}