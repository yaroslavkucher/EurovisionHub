@model EurovisionHub.Models.Vote

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Vote</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FromCountry)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FromCountry.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ToParticipation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ToParticipation.Country.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsJury)
        </dt>
        <dd class="col-sm-10">
            @(Model.IsJury ? "Jury" : "Televote")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Points)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Points)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsAdmin())
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-glass-edit">Edit</a>
    }
    <a asp-action="Index" asp-route-eventId="@ViewBag.SelectedEventId" class="btn-glass-submit">Back to List</a>
</div>
