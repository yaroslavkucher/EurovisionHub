@model EurovisionHub.Models.Country

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Country</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Code)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Code)
        </dd>

        @section Scripts
        {

            <script>
                function copyToClipboard(elementId) {
                const text = document.getElementById(elementId).innerText;
                navigator.clipboard.writeText(text).then(() => {
                toastr.success('Link successfully copied');
                }).catch(err => {
                toastr.error('Link not copied');
                });
                }
            </script>
        }

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FlagUrl)
        </dt>
        <dd class="col-sm-10 d-flex align-items-center">
            <div class="url-truncate-wrapper">
                <span class="url-text" id="flagUrlText">@Model.FlagUrl</span>
                <div class="url-blur-overlay"></div>
            </div>
            <button class="btn btn-link btn-sm text-decoration-none p-0 ms-2"
                    onclick="copyToClipboard('flagUrlText')"
                    title="Copy link">
                <img src="~/img/copy.png" width="16" style="opacity: 0.7;" />
                <span style="font-size: 0.85rem;">Copy</span>
            </button>
        </dd>
    </dl>
</div>
<div>
    @if (User.IsAdmin())
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-glass-edit">Edit</a>
    }
    <a asp-action="Index" class="btn-glass-submit">Back to List</a>
</div>
<hr />
<div class="row">
    <div class="col-md-10 offset-md-1">
        <h4 class="text-center">Історія виступів країни</h4>
        <canvas id="countryHistoryChart" style="max-height: 400px;"></canvas>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    const years = @Html.Raw(Json.Serialize(ViewBag.Years));
    const places = @Html.Raw(Json.Serialize(ViewBag.Places));

    const ctx = document.getElementById('countryHistoryChart').getContext('2d');
    new Chart(ctx, {
    type: 'line',
    data: {
    labels: years,
    datasets: [{
    label: 'Place in Final',
    data: places,
    borderColor: '#00d1ff',
    backgroundColor: 'rgba(0, 209, 255, 0.2)',
    borderWidth: 4,
    fill: false,
    tension: 0.3,
    pointRadius: 6,
    pointBackgroundColor: '#ff0050',
    pointBorderColor: 'white',
    pointBorderWidth: 2
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
    legend: {
    labels: {
    color: 'white',
    font: { size: 14 }
    }
    }
    },
    scales: {
    y: {
    reverse: true,
    beginAtZero: false,
    grid: {
    color: 'rgba(255, 255, 255, 0.1)'
    },
    ticks: {
    color: 'white',
    stepSize: 1
    },
    title: {
    display: true,
    text: 'Place',
    color: 'white'
    }
    },
    x: {
    grid: {
    display: false
    },
    ticks: {
    color: 'white'
    },
    title: {
    display: true,
    text: 'Year',
    color: 'white'
    }
    }
    }
    }
    });
    });
</script>